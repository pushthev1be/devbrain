# ─────────────────────────────────────────────────────────────────────────────
# DevBrain environment configuration
# Copy to ~/.devbrain/.env (CLI) or set on your Cloud Run service.
# ─────────────────────────────────────────────────────────────────────────────

# === AI backend (choose ONE) ===

# Option A — Gemini on Vertex AI (Google Cloud).  ← production / hosted default
# Authenticates via Application Default Credentials (ADC): the Cloud Run service
# account, or `gcloud auth application-default login` locally. No API key needed.
# Requires: Vertex AI API enabled on the project + the caller granted
# roles/aiplatform.user.
# NOTE: use location `global` for Gemini chat — AI-Studio-origin projects
# (gen-lang-client-*) serve Gemini 2.5 only via the global endpoint. Regional
# locations (e.g. us-central1) also work for embeddings.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional model overrides (defaults shown). gemini-2.5-flash is the current Flash
# model and works on both backends; gemini-2.0-flash is NOT available on
# gen-lang-client-* Vertex projects.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Option B — Gemini Developer API (AI Studio).  ← local / offline dev fallback
# Used only when GOOGLE_GENAI_USE_VERTEXAI is unset/false. Get a key at
# https://aistudio.google.com.
# GEMINI_API_KEY=your_gemini_api_key_here

# === Storage (optional) ===
# Leave MONGODB_URI unset and DevBrain stores memory locally in
# ~/.devbrain/db.json — no database to provision, works immediately.
# Set it to share one knowledge base across a team or several machines, and to
# use Atlas Vector Search (a 3072-dim cosine index named `embedding_index` on
# the `entries` collection) instead of in-memory ranking.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# === Offline mode (optional) ===
# Bypasses all Gemini calls with deterministic mock vectors/extractions.
# DEVBRAIN_MOCK=true
