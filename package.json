{
  "name": "devbrain-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run bundle",
    "dev": "npm run dev -w packages/cli",
    "pretest": "npm run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "icons": "node scripts/gen-stack-icons.mjs",
    "brand": "node scripts/gen-logo.mjs",
    "bundle": "node scripts/bundle.mjs",
    "publish:plugin": "npm run bundle && git subtree push --prefix=plugin https://github.com/pushthev1be/Devbrain-memory-Claudeplugin.git main"
  },
  "dependencies": {
    "@google/adk": "^1.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "rollup": "^4.64.3",
    "typescript": "5.4",
    "vitest": "^5.0.2"
  }
}
